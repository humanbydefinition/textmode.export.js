{
	"name": "textmode.export.js",
	"version": "1.7.0",
	"description": "Export plugin for textmode.js - Save your creations as images, GIFs, videos, SVG, JSON, and plain text.",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.0.0",
			"onFail": "error"
		}
	},
	"main": "./dist/textmode.export.umd.js",
	"module": "./dist/textmode.export.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.export.esm.js",
			"require": "./dist/textmode.export.umd.js"
		}
	},
	"sideEffects": [
		"./dist/textmode.export.esm.js",
		"./dist/textmode.export.umd.js"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "textmode-build dev --port 5174 --host",
		"build:bundle": "textmode-build build",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run format:check && npm run lint && npm run lint:markdown && npm run typecheck && npm run docs:check && npm run test && npm run build && npm run types:verify",
		"docs:links:add": "textmode-docs links add",
		"docs:api:check": "textmode-docs api-check",
		"docs:dev": "textmode-docs watch",
		"docs:build": "textmode-docs build",
		"docs:check": "textmode-docs check",
		"preview": "textmode-build preview",
		"test": "textmode-build test",
		"test:watch": "textmode-build test:watch",
		"format": "textmode-lint format",
		"format:check": "textmode-lint format:check",
		"typecheck": "textmode-types check",
		"types:verify": "textmode-types verify",
		"lint:markdown": "textmode-lint lint:markdown",
		"lint:markdown:fix": "textmode-lint lint:markdown --fix",
		"lint": "textmode-lint lint src",
		"prepare": "textmode-release hooks",
		"prepack": "npm run build && npm run types:verify",
		"release": "textmode-release release"
	},
	"peerDependencies": {
		"textmode.js": "^0.17.2-beta.2"
	},
	"dependencies": {
		"gifenc": "^1.0.1",
		"mediabunny": "^1.45.4"
	},
	"devDependencies": {
		"@textmode/build": "^0.1.0",
		"@textmode/docs": "^0.3.0",
		"@textmode/lint": "^0.1.0",
		"@textmode/release": "^0.2.0",
		"@textmode/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"textmode.js": "^0.17.2-beta.2",
		"typescript": "^6.0.3",
		"vite-plugin-css-injected-by-js": "^5.0.2",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"textmode",
		"textmode.js",
		"ascii",
		"petscii",
		"export",
		"plugin",
		"gif",
		"video",
		"webm",
		"svg",
		"json",
		"image",
		"png",
		"jpg",
		"webp",
		"creative-coding",
		"canvas"
	],
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"license": "MIT",
	"homepage": "https://code.textmode.art",
	"prettier": "@textmode/lint/prettier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.export.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.export.js/issues"
	}
}
