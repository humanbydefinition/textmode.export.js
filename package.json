{
	"name": "textmode.export.js",
	"version": "1.9.0-beta.2",
	"description": "Export plugin for textmode.js - Save images, GIFs, videos, SVG, JSON, text, and ZIP frame sequences.",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.0.0",
			"onFail": "error"
		}
	},
	"main": "./dist/textmode.export.umd.js",
	"module": "./dist/textmode.export.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.export.esm.js",
			"require": "./dist/textmode.export.umd.js"
		},
		"./document": {
			"types": "./dist/types/document/index.d.ts",
			"import": "./dist/textmode.document.esm.js"
		},
		"./schema": {
			"types": "./protocol/textmode-document/2.0/textmode-document-2.0.schema.d.ts",
			"default": "./protocol/textmode-document/2.0/textmode-document-2.0.schema.json"
		},
		"./document/schema/2.0": {
			"types": "./protocol/textmode-document/2.0/textmode-document-2.0.schema.d.ts",
			"default": "./protocol/textmode-document/2.0/textmode-document-2.0.schema.json"
		},
		"./document/fixtures/2.0/textmode-document-selected-v2.json": {
			"types": "./protocol/textmode-document/2.0/fixture.d.ts",
			"default": "./protocol/textmode-document/2.0/fixtures/textmode-document-selected-v2.json"
		},
		"./document/fixtures/2.0/textmode-document-all-v2.json": {
			"types": "./protocol/textmode-document/2.0/fixture.d.ts",
			"default": "./protocol/textmode-document/2.0/fixtures/textmode-document-all-v2.json"
		},
		"./document/fixtures/2.0/textmode-document-create-integration-v2.json": {
			"types": "./protocol/textmode-document/2.0/fixture.d.ts",
			"default": "./protocol/textmode-document/2.0/fixtures/textmode-document-create-integration-v2.json"
		},
		"./document/fixtures/2.0/textmode-layer-selected-v1.json": {
			"types": "./protocol/textmode-document/2.0/fixture.d.ts",
			"default": "./protocol/textmode-document/2.0/fixtures/textmode-layer-selected-v1.json"
		},
		"./document/fixtures/2.0/textmode-layer-all-v1.1.json": {
			"types": "./protocol/textmode-document/2.0/fixture.d.ts",
			"default": "./protocol/textmode-document/2.0/fixtures/textmode-layer-all-v1.1.json"
		}
	},
	"sideEffects": [
		"./dist/textmode.export.esm.js",
		"./dist/textmode.export.umd.js"
	],
	"files": [
		"dist",
		"protocol/textmode-document/2.0"
	],
	"scripts": {
		"prebuild": "npm run clean",
		"clean": "rm -rf dist",
		"dev": "textmode-build dev --port 5174 --host",
		"build:bundle": "textmode-build build",
		"build:document": "vite build --config vite.document.config.ts",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:document && npm run build:types",
		"check": "npm run format:check && npm run lint && npm run lint:markdown && npm run typecheck && npm run docs:check && npm run test && npm run build && npm run types:verify",
		"docs:links:add": "textmode-docs links add",
		"docs:api:check": "textmode-docs api-check",
		"docs:dev": "textmode-docs watch",
		"docs:build": "textmode-docs build",
		"docs:check": "textmode-docs check",
		"preview": "textmode-build preview",
		"test": "textmode-build test",
		"test:watch": "textmode-build test:watch",
		"format": "textmode-lint format",
		"format:check": "textmode-lint format:check",
		"typecheck": "textmode-types check",
		"types:verify": "textmode-types verify",
		"lint:markdown": "textmode-lint lint:markdown",
		"lint:markdown:fix": "textmode-lint lint:markdown --fix",
		"lint": "textmode-lint lint src",
		"prepare": "textmode-release hooks",
		"prepack": "npm run build && npm run types:verify",
		"release": "textmode-release release"
	},
	"peerDependencies": {
		"textmode.js": "^0.18.0"
	},
	"dependencies": {
		"fflate": "0.8.3",
		"gifenc": "^1.0.1",
		"mediabunny": "1.56.1"
	},
	"devDependencies": {
		"@textmode/build": "^0.1.1",
		"@textmode/docs": "^0.3.0",
		"@textmode/lint": "^0.1.2",
		"@textmode/release": "^0.2.0",
		"@textmode/tsconfig": "^0.2.2",
		"@types/node": "^26.4.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"textmode.js": "^0.18.0",
		"typescript": "^6.0.3",
		"vite-plugin-css-injected-by-js": "^5.0.2",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"textmode",
		"textmode.js",
		"ascii",
		"petscii",
		"export",
		"plugin",
		"gif",
		"video",
		"webm",
		"svg",
		"json",
		"image",
		"png",
		"jpg",
		"webp",
		"zip",
		"frame-sequence",
		"creative-coding",
		"canvas"
	],
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"license": "MIT",
	"homepage": "https://code.textmode.art",
	"prettier": "@textmode/lint/prettier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.export.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.export.js/issues"
	}
}
