{
	"name": "textmode.export.js",
	"version": "1.6.0-beta.2",
	"description": "Export plugin for textmode.js - Save your creations as images, GIFs, videos, SVG, JSON, and plain text.",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "^11.0.0",
			"onFail": "error"
		}
	},
	"main": "./dist/textmode.export.umd.js",
	"module": "./dist/textmode.export.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.export.esm.js",
			"require": "./dist/textmode.export.umd.js"
		}
	},
	"sideEffects": [
		"./dist/textmode.export.esm.js",
		"./dist/textmode.export.umd.js"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite --port 5174 --host",
		"build:bundle": "vite build",
		"build:types": "textmode-types build",
		"build": "npm run build:bundle && npm run build:types",
		"check": "textmode-project check",
		"docs:links:add": "textmode-docs links add",
		"docs:api:check": "textmode-docs api-check",
		"docs:dev": "textmode-docs watch",
		"docs:build": "textmode-docs build",
		"docs:check": "textmode-docs check",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"typecheck": "textmode-types check",
		"types:verify": "textmode-types verify",
		"lint:markdown": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2",
		"lint:markdown:fix": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2 --fix",
		"lint": "eslint src",
		"prepare": "install-git-hooks",
		"prepack": "textmode-project prepack",
		"release": "semantic-release"
	},
	"peerDependencies": {
		"textmode.js": ">=0.16.0"
	},
	"dependencies": {
		"gifenc": "^1.0.1",
		"mediabunny": "^1.45.4"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/docs": "^0.2.2",
		"@textmode/eslint-config": "^0.2.0",
		"@textmode/markdownlint-config": "^0.1.1",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/release-config": "^0.1.2",
		"@textmode/tooling-scripts": "^0.5.0",
		"@textmode/tsconfig": "^0.2.0",
		"@textmode/vite-config": "^0.1.0",
		"@types/node": "^24.0.0",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.6.0",
		"jsdom": "^30.0.0",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.4",
		"semantic-release": "^25.0.5",
		"terser": "^5.46.1",
		"textmode.js": "^0.17.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vite-plugin-css-injected-by-js": "^5.0.2",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"textmode",
		"textmode.js",
		"ascii",
		"petscii",
		"export",
		"plugin",
		"gif",
		"video",
		"webm",
		"svg",
		"json",
		"image",
		"png",
		"jpg",
		"webp",
		"creative-coding",
		"canvas"
	],
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"license": "MIT",
	"homepage": "https://code.textmode.art",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.export.js.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.export.js/issues"
	},
	"markdownlint-cli2": {
		"globs": [
			"**/*.md"
		],
		"ignores": [
			"api/**",
			"node_modules/**",
			"dist/**",
			"examples/**/*.md",
			"**/CHANGELOG.md"
		],
		"fix": false,
		"outputFormatters": [
			[
				"markdownlint-cli2-formatter-default"
			]
		],
		"config": {
			"extends": "@textmode/markdownlint-config"
		}
	},
	"release": {
		"extends": "@textmode/release-config"
	}
}
