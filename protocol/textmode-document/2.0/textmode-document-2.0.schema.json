{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://textmode.art/schemas/textmode-document-2.0.schema.json",
	"title": "Textmode document 2.0",
	"description": "Editable textmode cell snapshots and layer stacks.",
	"oneOf": [{ "$ref": "#/$defs/selectedDocument" }, { "$ref": "#/$defs/allDocument" }],
	"$defs": {
		"positiveSafeInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"canvas": {
			"type": "object",
			"required": ["width", "height"],
			"properties": {
				"width": { "$ref": "#/$defs/positiveSafeInteger" },
				"height": { "$ref": "#/$defs/positiveSafeInteger" }
			},
			"additionalProperties": true
		},
		"grid": {
			"type": "object",
			"required": ["cols", "rows", "cellWidth", "cellHeight"],
			"properties": {
				"cols": { "$ref": "#/$defs/positiveSafeInteger" },
				"rows": { "$ref": "#/$defs/positiveSafeInteger" },
				"cellWidth": { "$ref": "#/$defs/positiveSafeInteger" },
				"cellHeight": { "$ref": "#/$defs/positiveSafeInteger" }
			},
			"additionalProperties": true
		},
		"rgba": {
			"type": "object",
			"required": ["r", "g", "b", "a"],
			"properties": {
				"r": { "type": "integer", "minimum": 0, "maximum": 255 },
				"g": { "type": "integer", "minimum": 0, "maximum": 255 },
				"b": { "type": "integer", "minimum": 0, "maximum": 255 },
				"a": { "type": "integer", "minimum": 0, "maximum": 255 }
			},
			"additionalProperties": true
		},
		"color": {
			"oneOf": [
				{ "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$" },
				{ "$ref": "#/$defs/rgba" }
			]
		},
		"transform": {
			"type": "object",
			"required": ["invert", "flipX", "flipY", "rotation"],
			"properties": {
				"invert": { "type": "boolean" },
				"flipX": { "type": "boolean" },
				"flipY": { "type": "boolean" },
				"rotation": { "type": "number" }
			},
			"additionalProperties": true
		},
		"cell": {
			"type": "object",
			"required": ["x", "y", "character", "foreground", "background", "transform"],
			"properties": {
				"x": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"y": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"character": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"foreground": { "$ref": "#/$defs/color" },
				"background": { "$ref": "#/$defs/color" },
				"transform": { "$ref": "#/$defs/transform" }
			},
			"additionalProperties": true
		},
		"cells": {
			"type": "object",
			"required": ["encoding", "rows"],
			"properties": {
				"encoding": { "const": "object-rows-v1" },
				"rows": {
					"type": "array",
					"items": {
						"type": "array",
						"items": { "$ref": "#/$defs/cell" }
					}
				}
			},
			"additionalProperties": true
		},
		"metadata": {
			"type": "object",
			"required": ["createdAt", "generator"],
			"properties": {
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
				},
				"generator": {
					"type": "object",
					"required": ["name", "version"],
					"properties": {
						"name": { "type": "string", "minLength": 1 },
						"version": { "type": "string", "minLength": 1 }
					},
					"additionalProperties": true
				}
			},
			"additionalProperties": true
		},
		"selectedLayer": {
			"type": "object",
			"required": ["id", "cells"],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"cells": { "$ref": "#/$defs/cells" }
			},
			"additionalProperties": true
		},
		"stackLayer": {
			"type": "object",
			"required": ["id", "visible", "opacity", "blendMode", "offsetX", "offsetY", "rotationZ", "grid", "cells"],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"visible": { "type": "boolean" },
				"opacity": { "type": "number", "minimum": 0, "maximum": 1 },
				"blendMode": { "type": "string", "minLength": 1 },
				"offsetX": { "type": "number" },
				"offsetY": { "type": "number" },
				"rotationZ": { "type": "number" },
				"grid": { "$ref": "#/$defs/grid" },
				"cells": { "$ref": "#/$defs/cells" }
			},
			"additionalProperties": true
		},
		"selectedDocument": {
			"type": "object",
			"required": ["format", "formatVersion", "target", "canvas", "grid", "layer"],
			"properties": {
				"format": { "const": "textmode.document" },
				"formatVersion": { "const": "2.0.0" },
				"target": { "const": "selected" },
				"metadata": { "$ref": "#/$defs/metadata" },
				"canvas": { "$ref": "#/$defs/canvas" },
				"grid": { "$ref": "#/$defs/grid" },
				"layer": { "$ref": "#/$defs/selectedLayer" }
			},
			"additionalProperties": true
		},
		"allDocument": {
			"type": "object",
			"required": ["format", "formatVersion", "target", "canvas", "layers"],
			"properties": {
				"format": { "const": "textmode.document" },
				"formatVersion": { "const": "2.0.0" },
				"target": { "const": "all" },
				"metadata": { "$ref": "#/$defs/metadata" },
				"canvas": { "$ref": "#/$defs/canvas" },
				"layers": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/stackLayer" }
				}
			},
			"additionalProperties": true
		}
	}
}
