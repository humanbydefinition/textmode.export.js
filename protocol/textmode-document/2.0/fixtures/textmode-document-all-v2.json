{
	"format": "textmode.document",
	"formatVersion": "2.0.0",
	"target": "all",
	"canvas": {
		"width": 8,
		"height": 8
	},
	"layers": [
		{
			"id": "base",
			"visible": true,
			"opacity": 1,
			"blendMode": "normal",
			"offsetX": 0,
			"offsetY": 0,
			"rotationZ": 0,
			"grid": {
				"cols": 1,
				"rows": 1,
				"cellWidth": 8,
				"cellHeight": 8
			},
			"cells": {
				"encoding": "object-rows-v1",
				"rows": [
					[
						{
							"x": 0,
							"y": 0,
							"character": "B",
							"foreground": "#ffffffff",
							"background": "#000000ff",
							"transform": {
								"invert": true,
								"flipX": false,
								"flipY": false,
								"rotation": -90
							}
						}
					]
				]
			}
		},
		{
			"id": "accent",
			"visible": false,
			"opacity": 0.5,
			"blendMode": "multiply",
			"offsetX": -2,
			"offsetY": 3,
			"rotationZ": 15,
			"grid": {
				"cols": 2,
				"rows": 1,
				"cellWidth": 4,
				"cellHeight": 8
			},
			"cells": {
				"encoding": "object-rows-v1",
				"rows": [
					[
						{
							"x": 0,
							"y": 0,
							"character": "C",
							"foreground": "#ff000080",
							"background": "#00000000",
							"transform": {
								"invert": false,
								"flipX": true,
								"flipY": false,
								"rotation": 45
							}
						},
						{
							"x": 1,
							"y": 0,
							"character": " ",
							"foreground": "#00000000",
							"background": "#123456ff",
							"transform": {
								"invert": false,
								"flipX": false,
								"flipY": true,
								"rotation": 0
							}
						}
					]
				]
			}
		}
	]
}
